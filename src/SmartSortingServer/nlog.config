<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

	<targets>
		<target xsi:type="Console"
				name="console"
				layout="${message}" />
	</targets>

	<rules>
		<logger name="Microsoft.AspNetCore.DataProtection.*"
				maxlevel="Info"
				final="true" />
		
		<logger name="Microsoft.EntityFrameworkCore.*"
				minlevel="Warn"
				writeTo="console" />

		<logger name="Microsoft.AspNetCore.*"
				minlevel="Warn"
				writeTo="console" />

		<logger name="Microsoft.Hosting.Lifetime*"
				minlevel="Info"
				writeTo="console" />

		<logger name="*"
				minlevel="Info"
				writeTo="console" />
	</rules>

</nlog>